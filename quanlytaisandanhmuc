    <!-- Dashboard App js -->

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ==============================
            // 1. VIEW SWITCHER
            // ==============================
            const sections = document.querySelectorAll('[data-section]');
            const tabs = document.querySelectorAll('#assetTabs [data-view]');

            function showView(view) {
                sections.forEach(section => {
                    section.classList.toggle('active', section.getAttribute('data-section') === view);
                });

                tabs.forEach(tab => {
                    tab.classList.toggle('active', tab.getAttribute('data-view') === view);
                });

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            tabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    showView(this.getAttribute('data-view'));
                });
            });

            document.querySelectorAll('[data-view-target]').forEach(btn => {
                btn.addEventListener('click', function () {
                    showView(this.getAttribute('data-view-target'));
                });
            });

            document.querySelectorAll('[data-detail-id]').forEach(btn => {
                btn.addEventListener('click', function () {
                    showView('detail');
                });
            });

            const btnAddAsset = document.getElementById('btnAddAsset');
            if (btnAddAsset) {
                btnAddAsset.addEventListener('click', function () {
                    showView('detail');
                });
            }

            // ==============================
            // 2. LANGUAGE
            // ==============================
            const LANG_STORAGE_KEY = 'site-lang';
            const langToggleFlag = document.getElementById('langToggleFlag');
            const langToggleLabel = document.getElementById('langToggleLabel');
            const langOptions = document.querySelectorAll('.language-option');
            const translatable = document.querySelectorAll('[data-vi][data-en]');

            function applyLanguage(lang) {
                document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'vi');

                translatable.forEach(el => {
                    const text = el.getAttribute(lang === 'en' ? 'data-en' : 'data-vi');
                    if (text !== null) el.textContent = text;
                });

                document.querySelectorAll('[data-placeholder-vi][data-placeholder-en]').forEach(el => {
                    el.placeholder = el.getAttribute(
                        lang === 'en' ? 'data-placeholder-en' : 'data-placeholder-vi'
                    );
                });

                document.querySelectorAll('option[data-vi][data-en]').forEach(el => {
                    el.textContent = el.getAttribute(lang === 'en' ? 'data-en' : 'data-vi');
                });

                const activeOption = document.querySelector(
                    `.language-option[data-lang="${lang}"]`
                );

                if (activeOption && langToggleFlag && langToggleLabel) {
                    langToggleFlag.src = activeOption.getAttribute('data-flag');
                    langToggleLabel.textContent = activeOption.getAttribute('data-label');
                }

                langOptions.forEach(opt => {
                    opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
                });

                updateConditionChart(lang);
            }

            function setLanguage(lang) {
                localStorage.setItem(LANG_STORAGE_KEY, lang);
                applyLanguage(lang);
            }

            langOptions.forEach(opt => {
                opt.addEventListener('click', function (e) {
                    e.preventDefault();
                    setLanguage(this.getAttribute('data-lang'));
                });
            });

            // ==============================
            // 3. CONDITION CHART
            // ==============================
            let conditionChart = null;

            function chartTextColor() {
                return getComputedStyle(document.documentElement)
                    .getPropertyValue('--bs-body-color').trim() || '#6c757d';
            }

            function updateConditionChart(lang) {
                if (!conditionChart) return;

                conditionChart.updateOptions({
                    labels: lang === 'en'
                        ? ['Good', 'Warning', 'Damaged', 'Other']
                        : ['Tốt', 'Cảnh báo', 'Hỏng', 'Khác'],
                    chart: { foreColor: chartTextColor() }
                });
            }

            if (window.ApexCharts) {
                const chartEl = document.querySelector('#assetConditionChart');

                if (chartEl) {
                    conditionChart = new ApexCharts(chartEl, {
                        series: [82, 9, 5, 4],
                        labels: ['Tốt', 'Cảnh báo', 'Hỏng', 'Khác'],
                        chart: {
                            type: 'donut',
                            height: 250,
                            toolbar: { show: false },
                            foreColor: chartTextColor()
                        },
                        plotOptions: {
                            pie: {
                                donut: {
                                    size: '70%',
                                    labels: {
                                        show: true,
                                        total: {
                                            show: true,
                                            label: 'Tổng',
                                            formatter: function () {
                                                return '100%';
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        dataLabels: { enabled: false },
                        legend: { show: false },
                        stroke: { width: 2 },
                        tooltip: {
                            y: {
                                formatter: value => value + '%'
                            }
                        }
                    });

                    conditionChart.render();
                }
            }

            // ==============================
            // 4. FOOTER / THEME
            // ==============================
            const navbarEl = document.querySelector('.navbar-custom');
            const footerEl = document.querySelector('.footer-theme-synced');

            function syncFooterTheme() {
                if (!navbarEl || !footerEl) return;

                const navStyle = window.getComputedStyle(navbarEl);
                footerEl.style.backgroundColor = navStyle.backgroundColor;
                footerEl.style.color = navStyle.color;
                footerEl.style.borderTop =
                    '1px solid ' + (navStyle.borderBottomColor || navStyle.color);

                if (conditionChart) {
                    conditionChart.updateOptions({
                        chart: { foreColor: chartTextColor() }
                    });
                }
            }

            syncFooterTheme();

            const themeToggleBtn = document.getElementById('light-dark-mode');
            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', function () {
                    setTimeout(syncFooterTheme, 0);
                });
            }

            const themeObserver = new MutationObserver(syncFooterTheme);
            themeObserver.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ['data-bs-theme']
            });

            // ==============================
            // 5. INIT
            // ==============================
            const savedLang = localStorage.getItem(LANG_STORAGE_KEY) || 'vi';
            applyLanguage(savedLang);
        });
    </script>

